# RPC da Sepolia (ex: Alchemy ou Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_CHAVE_AQUI

# Chave privada da carteira de deploy (SEM o prefixo 0x)
PRIVATE_KEY=sua_chave_privada_aqui

# API key do Etherscan para verificação do contrato
ETHERSCAN_API_KEY=sua_chave_etherscan_aqui

# Habilita relatório de gas nos testes (true/false)
REPORT_GAS=false
